{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qrati-connect-angular-example",
  "compatibility_date": "2026-04-16",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist/qrati-connect-angular-example/browser",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}